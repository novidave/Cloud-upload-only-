{
  "name": "cacaduu-upload",
  "private": true,
  "version": "1.1.0",
  "description": "Sends the newest stock file from the shop's export folder to cacaduu.com in the background.",
  "scripts": {
    "tauri": "tauri",
    "start": "tauri dev",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build:win": "tauri build --bundles nsis",
    "build:mac": "tauri build --bundles dmg --target universal-apple-darwin"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4"
  }
}
